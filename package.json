{
  "name": "otterjobs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "App de escritorio para la búsqueda de trabajo: tablero, tareas, bandeja de Gmail y Claude Code sobre tu carpeta de datos",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "otterjobs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/cli.ts"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "43.8.6",
    "electron-vite": "^6.0.0",
    "lucide-react": "^0.577.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "velopack": "1.3.39-g8d2844f"
  }
}
